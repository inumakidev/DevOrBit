{
  "algorithm": "SHA-256 over the exact manifest bytes",
  "independentVerification": {
    "provenance": "The ASCII JSON serializations were prepared directly as fixed bytes, then hashed independently using PowerShell 5.1/.NET SHA256.ComputeHash. The expected values were not produced by the registry implementation.",
