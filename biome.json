{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "package.json",
      "tsconfig.base.json",
      "biome.json",
      "vitest.config.ts",
      "apps/cli/src/**/*.ts",
      "apps/cli/package.json",
      "apps/cli/tsconfig.json",
      "packages/core/src/**/*.ts",
      "packages/core/package.json",
      "packages/core/tsconfig.json",
      "tests/**/*.ts",
      "tests/**/*.json",
      "schemas/**/*.json"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
